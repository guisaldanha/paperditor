// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.paperditor.app",
  "asar": true,
  "productName": "Paperditor",
  "icon": "public/icon.png",
  // O workflow de release (.github/workflows/release.yml) só quer que o electron-builder
  // EMPACOTE — quem publica a release no GitHub é o job "release" separado, via `gh
  // release create`. Sem isso, o electron-builder detecta a tag no CI e tenta publicar
  // ele mesmo, falhando por falta de GH_TOKEN nesse step.
  "publish": null,
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "fileAssociations": [
    {
      "ext": "md",
      "name": "Markdown Document",
      "description": "Arquivo Markdown",
      "role": "Editor"
    },
    {
      "ext": "markdown",
      "name": "Markdown Document",
      "description": "Arquivo Markdown",
      "role": "Editor"
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "appx",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  // Config da Microsoft Store (MSIX/AppX). identityName e publisher vêm do Partner Center
  // depois de reservar o nome do app — são específicos da sua conta, não dá pra usar
  // qualquer valor. Ícones já gerados em build/appx/ (a partir de public/icon.png).
  // @see https://www.electron.build/docs/appx/
  "appx": {
    "applicationId": "Paperditor",
    "identityName": "GuilhermeSaldanha.Paperditor",
    "publisher": "CN=433358B9-1FAE-474A-89FA-476A3C1372E1",
    "publisherDisplayName": "Guilherme Saldanha",
    "displayName": "Paperditor"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
